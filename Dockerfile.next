FROM node:20-bookworm-slim AS builder

WORKDIR /workspace

COPY package.json package-lock.json ./
RUN npm ci

COPY nx.json tsconfig.base.json jest.preset.js jest.config.ts eslint.config.mjs ./
ARG APP
COPY apps/${APP} ./apps/${APP}
COPY libs ./libs

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_BFF_URL
ENV NX_DAEMON=false
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_BFF_URL=${NEXT_PUBLIC_BFF_URL}
RUN npx nx build ${APP} --configuration=production --skip-nx-cache

FROM node:20-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ARG APP

COPY --from=builder --chown=node:node /workspace/apps/${APP}/.next/standalone ./
COPY --from=builder --chown=node:node /workspace/apps/${APP}/.next/static ./apps/${APP}/.next/static
COPY --from=builder --chown=node:node /workspace/apps/${APP}/public ./apps/${APP}/public

WORKDIR /app/apps/${APP}

USER node

CMD ["node", "server.js"]
