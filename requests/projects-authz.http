@bffUrl = http://localhost:3000
@userApiUrl = http://localhost:3001/api
@password = Pass1234!

### Setup: create a normal user through BFF
# @name registerUser
POST {{bffUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "project-user-{{$timestamp}}@example.com",
  "name": "Project User",
  "password": "{{password}}"
}

### Setup: create an admin user directly in user-api
# In production this service should be internal. We use it here only to prepare the manual test.
# @name registerAdmin
POST {{userApiUrl}}/users
Content-Type: application/json

{
  "email": "project-admin-{{$timestamp}}@example.com",
  "name": "Project Admin",
  "password": "{{password}}",
  "roles": ["user", "admin"]
}

### Login normal user
# @name loginUser
POST {{bffUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{registerUser.response.body.$.email}}",
  "password": "{{password}}"
}

### Login admin user
# @name loginAdmin
POST {{bffUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{registerAdmin.response.body.$.email}}",
  "password": "{{password}}"
}

### Create project without token should return 401
POST {{bffUrl}}/api/projects
Content-Type: application/json

{
  "name": "Private Project No Token",
  "businessUnit": "Engineering",
  "description": "Should fail because there is no JWT"
}

### Create project with normal user should return 403
POST {{bffUrl}}/api/projects
Authorization: Bearer {{loginUser.response.body.$.access_token}}
Content-Type: application/json

{
  "name": "Private Project User",
  "businessUnit": "Engineering",
  "description": "Should fail because user is not admin"
}

### Create project with admin should return 201
POST {{bffUrl}}/api/projects
Authorization: Bearer {{loginAdmin.response.body.$.access_token}}
Content-Type: application/json

{
  "name": "Private Project Admin {{$timestamp}}",
  "businessUnit": "Engineering",
  "description": "Should work because user is admin"
}
