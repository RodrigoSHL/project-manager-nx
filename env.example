# ========================================
# CONFIGURACIÓN GENERAL DEL MONOREPO
# ========================================

# Base de datos — project-api
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=project_management_db
DATABASE_USERNAME=user_project
DATABASE_PASSWORD=password_project

# Base de datos — user-api (misma instancia PostgreSQL, distinta DB)
USER_DATABASE_NAME=user_management_db

# Base de datos — travel-planner-api
TRAVEL_DB_HOST=localhost
TRAVEL_DB_PORT=5432
TRAVEL_DB_NAME=travel_planner_db
TRAVEL_DB_USERNAME=postgres
TRAVEL_DB_PASSWORD=postgres
EXCHANGE_RATES_API_URL=https://api.frankfurter.dev/v2
EXCHANGE_RATES_CACHE_TTL_SECONDS=900
EXCHANGE_RATES_TIMEOUT_MS=5000

# Base de datos y almacenamiento — files-api
FILES_DB_HOST=localhost
FILES_DB_PORT=5432
FILES_DB_NAME=files_db
FILES_DB_USERNAME=postgres
FILES_DB_PASSWORD=postgres
FILES_STORAGE_DRIVER=database
FILES_MAX_FILE_SIZE_BYTES=10485760
FILES_MIGRATIONS_RUN=false

# Configuración de la API
API_PORT=3002
USER_API_PORT=3001
BFF_PORT=3000
FILES_API_PORT=3004
API_PREFIX=api
NODE_ENV=development

# Configuración de CORS
CORS_ORIGIN=http://localhost:4200

# Configuración de Logging
LOG_LEVEL=debug

# Configuración de JWT (para futuras implementaciones)
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# URLs internas para el BFF
PROJECT_API_URL=http://localhost:3002
USER_API_URL=http://localhost:3001
FILES_API_URL=http://localhost:3004/api

# Configuración de Swagger
SWAGGER_TITLE=Project Management API
SWAGGER_DESCRIPTION=API para gestión de proyectos técnicos
SWAGGER_VERSION=1.0

# Configuración de Redis (para futuras implementaciones)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Configuración de Email (para futuras implementaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Configuración de AWS (para futuras implementaciones)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name

# Configuración de Monitoreo
SENTRY_DSN=your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-new-relic-key
