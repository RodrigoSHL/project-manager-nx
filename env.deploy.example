# Copy to .env.deploy and change every secret before deploying.

DATABASE_NAME=project_management_db
USER_DATABASE_NAME=user_management_db
TRAVEL_DB_NAME=travel_planner_db
TRAVEL_MIGRATIONS_RUN=false
DATABASE_USERNAME=project_user
DATABASE_PASSWORD=project_password
DATABASE_SSL=false

JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=24h

# First deploy currently needs true because the repo has no TypeORM migrations yet.
# Change to false after adding migrations.
TYPEORM_SYNCHRONIZE=true

# Local defaults:
HTTP_PORT=80
HTTPS_PORT=443
JIRA_HTTP_PORT=8081
TRAVEL_HTTP_PORT=8082
PROJECT_WEB_HOST=:80
JIRA_WEB_HOST=:8081
TRAVEL_WEB_HOST=:8082
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_BFF_URL=
CORS_ORIGIN=http://localhost,http://localhost:8081,http://localhost:8082

# Example with real domains:
# PROJECT_WEB_HOST=projects.example.com
# JIRA_WEB_HOST=jira.example.com
# TRAVEL_WEB_HOST=travel.example.com
# NEXT_PUBLIC_API_URL=/api
# CORS_ORIGIN=https://pm.example.com,https://jira.example.com,https://travel.example.com
