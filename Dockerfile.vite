FROM node:20-bookworm-slim AS builder

WORKDIR /workspace

COPY package.json package-lock.json ./
RUN npm ci

COPY nx.json tsconfig.base.json jest.preset.js jest.config.ts eslint.config.mjs ./
COPY apps ./apps

ARG APP
ENV NX_DAEMON=false
RUN npx nx build ${APP} --configuration=production --skip-nx-cache

FROM nginx:1.27-alpine AS runner

ARG APP

COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/dist/apps/${APP} /usr/share/nginx/html
RUN rm -f /usr/share/nginx/html/*.md

EXPOSE 80
